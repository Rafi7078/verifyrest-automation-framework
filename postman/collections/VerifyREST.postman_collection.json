    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Create Auth Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is JSON\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\"))\r",
                  "        .to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Token is returned\", function () {\r",
                  "    pm.expect(responseData).to.have.property(\"token\");\r",
                  "    pm.expect(responseData.token).to.be.a(\"string\");\r",
                  "    pm.expect(responseData.token.length).to.be.greaterThan(0);\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"token\", responseData.token);\r",
                  "\r",
                  "console.log(\"Authentication token saved to environment\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"username\": \"{{authUsername}}\",\r\n  \"password\": \"{{authPassword}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
