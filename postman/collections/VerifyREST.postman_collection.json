    {
      "name": "02 - Booking Management",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Booking ID is returned\", function () {\r",
                  "    pm.expect(responseData).to.have.property(\"bookingid\");\r",
                  "    pm.expect(responseData.bookingid).to.be.a(\"number\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Booking data is correct\", function () {\r",
                  "    pm.expect(responseData.booking.firstname).to.eql(\"Rafi\");\r",
                  "    pm.expect(responseData.booking.lastname).to.eql(\"Automation\");\r",
                  "    pm.expect(responseData.booking.totalprice).to.eql(750);\r",
                  "    pm.expect(responseData.booking.depositpaid).to.eql(true);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Booking dates are correct\", function () {\r",
                  "    pm.expect(responseData.booking.bookingdates.checkin)\r",
                  "        .to.eql(\"2026-09-10\");\r",
                  "\r",
                  "    pm.expect(responseData.booking.bookingdates.checkout)\r",
                  "        .to.eql(\"2026-09-15\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Additional needs is correct\", function () {\r",
                  "    pm.expect(responseData.booking.additionalneeds)\r",
                  "        .to.eql(\"Breakfast\");\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"bookingId\", responseData.bookingid);\r",
                  "\r",
                  "console.log(\"Booking ID saved:\", responseData.bookingid);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
